{% extends 'base.html.twig' %}

{% block title %}Dashboard Militants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('/styles/partials.css') }}">
{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    {# Rafraîchissement automatique toutes les 60s #}
    <meta http-equiv="refresh" content="60">

    <div class="dashboard-container" data-controller="native-board">

        {# ================================================= #}
        {# ZONE 1 : SIDEBAR (PÔLE 1)                         #}
        {# ================================================= #}
        <aside class="sidebar-wrapper">
            {% set pole1 = null %}
            {% for pole in poles %}{% if pole.id == 1 %}{% set pole1 = pole %}{% endif %}{% endfor %}

            {% if pole1 %}
                <div class="sidebar-section">
                    <h3 class="sidebar-title">
                        <i class="fas fa-crown"></i> {{ pole1.nomPole }}
                    </h3>
                    
                    <div class="sidebar-grid" 
                         data-pole="{{ pole1.nomPole }}"
                         data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                        
                        {# On utilise le groupement par pôle envoyé par le contrôleur #}
                        {% for militant in militantsParPole[pole1.nomPole] ?? [] %}
                            {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </aside>

        {# ================================================= #}
        {# ZONE 2 : CONTENU PRINCIPAL (HORIZONTAL)           #}
        {# ================================================= #}
        <main class="main-content-wrapper">
            <h2 class="mb-4">Flux des Pôles</h2>

            <div class="main-grid-layout">
                {# On boucle sur les pôles restants #}
                {% for pole in poles %}
                    {% if pole.id != 1 %}
                        <section class="pole-section card shadow-sm">
                            <div class="card-header bg-white">
                                <h4 class="pole-title m-0">{{ pole.nomPole }}</h4>
                            </div>
                            
                            <div class="card-body bg-light">
                                <div class="dashboard-grid" 
                                     data-pole="{{ pole.nomPole }}"
                                     data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                                    
                                    {# On affiche les militants de ce pôle via le tableau groupé #}
                                    {% for militant in militantsParPole[pole.nomPole] ?? [] %}
                                        {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                                    {% endfor %}
                                </div>
                            </div>
                        </section>
                    {% endif %}
                {% endfor %}
            </div>
        </main>
    </div>

    {# Ton script JS toggleRepas reste ici... #}
{% endblock %}