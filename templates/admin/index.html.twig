{% extends 'base.html.twig' %}

{% block title %}Dashboard Militants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('/styles/partials.css') }}">
{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    {# Rafraîchissement automatique toutes les 60s pour voir les nouveaux scores/militants #}
    <meta http-equiv="refresh" content="60">

    {# ... début du fichier ... #}
    <div class="dashboard-container" data-controller="native-board">

{# templates/admin/index.html.twig #}

    <aside class="sidebar-wrapper">
        {# --- PÔLE 1 (Exécutif / Fixe) --- #}
        {% set pole1 = null %}
        {% for pole in poles %}{% if pole.id == 1 %}{% set pole1 = pole %}{% endif %}{% endfor %}

        {% if pole1 %}
            <div class="sidebar-section">
                <h3 class="sidebar-title"><i class="fas fa-crown"></i> {{ pole1.nomPole }}</h3>
                
                {# --- BARRE DE RECHERCHE AJOUTÉE ICI --- #}
                <div class="search-bar-container px-3 mb-3">
                    <form action="{{ path('app_admin') }}" method="get" class="d-flex shadow-sm">
                        <div class="input-group">
                            <input 
                                type="text" 
                                name="q" 
                                value="{{ searchTerm|default('') }}" 
                                class="form-control form-control-sm border-end-0" 
                                placeholder="Chercher un nom..."
                                style="border-radius: 20px 0 0 20px;"
                            >
                            {% if searchTerm %}
                                <a href="{{ path('app_admin') }}" class="btn btn-sm btn-white border-top border-bottom bg-white text-danger">
                                    <i class="fas fa-times"></i>
                                </a>
                            {% endif %}
                            <button class="btn btn-sm btn-primary" type="submit" style="border-radius: 0 20px 20px 0;">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="sidebar-grid" 
                    data-pole="{{ pole1.nomPole }}"
                    data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                    
                    {% set militantsPole1 = militantsParPole[1] ?? [] %}
                    
                    {% for militant in militantsPole1 %}
                        {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                    {% else %}
                        <p class="text-center text-muted small mt-2">Aucun résultat</p>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <hr>
    </aside>

        <main class="main-content-wrapper">
            <div class="main-grid-layout">
                {% for pole in poles %}
                    {% if pole.id != 1 %}
                        <section class="pole-section card shadow-sm">
                            <div class="card-header bg-white">
                                <h4 class="pole-title m-0">{{ pole.nomPole }}</h4>
                            </div>
                            <div class="card-body bg-light">
                                {# La min-height CSS permettra de drop ici même si c'est vide #}
                                <div class="dashboard-grid" 
                                    data-pole="{{ pole.nomPole }}"
                                    data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                                    {% for militant in militantsParPole[pole.id] ?? [] %}
                                        {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                                    {% endfor %}
                                </div>
                            </div>
                        </section>
                    {% endif %}
                {% endfor %}
            </div>
        </main>
    </div>
{# ... reste du fichier ... #}

    {# --- SCRIPT REPAS (Gestion AJAX) --- #}
    <script>
        function toggleRepas(element) {
            const url = element.dataset.url;
            const badge = element.querySelector('.badge-meal');
            const textSpan = element.querySelector('.meal-text');

            if (!url) return;

            badge.style.opacity = '0.5';
            badge.style.cursor = 'wait';

            fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                badge.style.opacity = '1';
                badge.style.cursor = 'pointer';

                if (data.aMange === true) {
                    badge.classList.remove('warning');
                    badge.classList.add('success');
                    textSpan.innerText = "a Mangé";
                } else {
                    badge.classList.remove('success');
                    badge.classList.add('warning');
                    textSpan.innerText = "Pas Mangé";
                }
            })
            .catch(err => {
                console.error(err);
                badge.style.opacity = '1';
                alert("Erreur lors de la mise à jour du repas");
            });
        }
    </script>
{% endblock %}