{% extends 'base.html.twig' %}

{% block title %}Dashboard Militants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('/styles/partials.css') }}">
{% endblock %}

{% block body %}
    {% include 'partials/_navbar.html.twig' %}
    
    {# Rafraîchissement automatique toutes les 60s pour voir les nouveaux scores/militants #}
    <meta http-equiv="refresh" content="60">

    <div class="dashboard-container" data-controller="native-board">

        {# ================================================= #}
        {# ZONE 1 : SIDEBAR (PÔLE 1 - EXÉCUTIF)              #}
        {# ================================================= #}
        <aside class="sidebar-wrapper">
            {% set pole1 = null %}
            {% for pole in poles %}
                {% if pole.id == 1 %}
                    {% set pole1 = pole %}
                {% endif %}
            {% endfor %}

            {% if pole1 %}
                <div class="sidebar-section">
                    <h3 class="sidebar-title">
                        <i class="fas fa-crown"></i> {{ pole1.nomPole }}
                    </h3>
                    
                    <div class="sidebar-grid" 
                         data-pole="{{ pole1.nomPole }}"
                         data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                        
                        {# On utilise l'ID '1' pour piocher dans le tableau groupé du Controller #}
                        {% for militant in militantsParPole[1] ?? [] %}
                            {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </aside>

        {# ================================================= #}
        {# ZONE 2 : CONTENU PRINCIPAL (HORIZONTAL)           #}
        {# ================================================= #}
        <main class="main-content-wrapper">
            <h2 class="mb-4">Flux des Pôles</h2>

            <div class="main-grid-layout">
                {# On boucle sur les pôles pour créer les colonnes #}
                {% for pole in poles %}
                    {# On exclut le pôle 1 car il est déjà dans la sidebar #}
                    {% if pole.id != 1 %}
                        <section class="pole-section card shadow-sm">
                            <div class="card-header bg-white">
                                <h4 class="pole-title m-0">{{ pole.nomPole }}</h4>
                            </div>
                            
                            <div class="card-body bg-light">
                                <div class="dashboard-grid" 
                                     data-pole="{{ pole.nomPole }}"
                                     data-action="dragover->native-board#onDragOver drop->native-board#onDrop dragenter->native-board#onDragEnter dragleave->native-board#onDragLeave">
                                    
                                    {# On récupère les militants via l'ID du pôle (clé du tableau PHP) #}
                                    {% for militant in militantsParPole[pole.id] ?? [] %}
                                        {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                                    {% endfor %}
                                    
                                </div>
                            </div>
                        </section>
                    {% endif %}
                {% endfor %}
            </div>
        </main>
    </div>

    {# --- SCRIPT REPAS (Gestion AJAX) --- #}
    <script>
        function toggleRepas(element) {
            const url = element.dataset.url;
            const badge = element.querySelector('.badge-meal');
            const textSpan = element.querySelector('.meal-text');

            if (!url) return;

            badge.style.opacity = '0.5';
            badge.style.cursor = 'wait';

            fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                badge.style.opacity = '1';
                badge.style.cursor = 'pointer';

                if (data.aMange === true) {
                    badge.classList.remove('warning');
                    badge.classList.add('success');
                    textSpan.innerText = "a Mangé";
                } else {
                    badge.classList.remove('success');
                    badge.classList.add('warning');
                    textSpan.innerText = "Pas Mangé";
                }
            })
            .catch(err => {
                console.error(err);
                badge.style.opacity = '1';
                alert("Erreur lors de la mise à jour du repas");
            });
        }
    </script>
{% endblock %}