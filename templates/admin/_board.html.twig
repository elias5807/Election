{# templates/admin/_board.html.twig #}
<div class="main-grid-layout">
    {% for pole in poles %}
        {# On exclut strictement l'ID 1 ici car il est déjà dans la sidebar #}
        {% if pole.id != 1 %}
            <section class="pole-section card shadow-sm">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h4 class="pole-title m-0">{{ pole.nomPole }}</h4>
                    <span class="badge bg-light text-dark">
                        {{ (militantsParPole[pole.id] ?? [])|length }}
                    </span>
                </div>
                
                <div class="card-body bg-light dashboard-grid" 
                     data-pole="{{ pole.nomPole }}"
                     data-action="dragover->native-board#onDragOver drop->native-board#onDrop">
                    
                    {% for militant in militantsParPole[pole.id] ?? [] %}
                        {% include 'partials/_militant_card.html.twig' with {'militant': militant} %}
                    {% endfor %}
                    
                    {# Zone d'aide au drop si le pôle est vide #}
                    {% if (militantsParPole[pole.id] ?? []) is empty %}
                        <div class="empty-drop-zone text-muted small text-center p-3" style="border: 2px dashed #ccc; border-radius: 8px;">
                            Déposer ici
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    {% endfor %}
</div>